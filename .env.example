# NOFX Environment Variables Template
# Copy this file to .env and modify the values as needed

# ===========================================
# Server Configuration
# ===========================================

# Backend API server port
NOFX_BACKEND_PORT=8080

# Frontend web interface port
NOFX_FRONTEND_PORT=3000

# Timezone
NOFX_TIMEZONE=Asia/Shanghai

# ===========================================
# Authentication (Required)
# ===========================================

# JWT signing secret (any random string, at least 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-change-this-in-production

# ===========================================
# Encryption Keys (Required)
# ===========================================

# AES-256 data encryption key (Base64 encoded, 32 bytes)
# Used for encrypting sensitive data in database (API keys, secrets)
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# RSA private key for client-server encryption (PEM format)
# Used for end-to-end encryption of sensitive data from browser
# Generate with: openssl genrsa 2048
# Note: Replace newlines with \n for single-line format
RSA_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----

# ===========================================
# Security Options
# ===========================================

# Transport encryption for API keys (default: false)
# When enabled, browser uses Web Crypto API to encrypt API keys before sending
# Requires HTTPS or localhost to work
# Set to true for enhanced security (HTTPS required)
# Set to false for easier deployment (HTTP/IP access allowed)
TRANSPORT_ENCRYPTION=false

# ===========================================
# Optional: Data Retention (数据自动清理，天数；0=该项禁用清理)
# ===========================================
# 系统每 24 小时自动清理过期历史数据（启动 5 分钟后首次执行）
# 未平仓仓位、进行中的 Copy Guard 周期、对账未完结的周期永不清理
# 以下为默认值，按需取消注释覆盖
# 已平仓仓位记录保留天数（注意：胜率/总盈亏等统计只反映保留窗口内数据）
# RETENTION_POSITION_DAYS=90
# AI/跟单决策记录保留天数（含 CoT 大文本，数据库最大占用项）
# RETENTION_DECISION_DAYS=30
# 权益快照全精度保留天数；更早的降采样为每天 1 条（长期净值曲线不中断）
# RETENTION_EQUITY_FULL_DAYS=90
# Copy Guard 事件日志保留天数（仅清理已关闭周期的事件）
# RETENTION_COPYGUARD_EVENT_DAYS=30
# Copy Guard 周期主档保留天数（对账未完结的延长至 2 倍）
# RETENTION_COPYGUARD_CYCLE_DAYS=180
# 跟单信号日志保留天数
# RETENTION_SIGNAL_LOG_DAYS=30
# 辩论会话保留天数（仅清理已完成/已取消的）
# RETENTION_DEBATE_DAYS=30
# data/nofx_*.log 日志文件保留天数
# RETENTION_LOG_FILE_DAYS=30

# ===========================================
# Optional: External Services
# ===========================================

# Telegram notifications (optional)
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# ===========================================
# Optional: Email Alerts (邮件告警，跟单/交易失败时通知)
# ===========================================
# 启用后，跟单执行失败等事件会异步发送告警邮件
# 默认 false，未设置或为 false 时整个邮件模块不工作，对现有逻辑零影响
# NOTIFY_EMAIL_ENABLED=true

# SMTP 服务器（网易：smtp.163.com，QQ：smtp.qq.com，Gmail：smtp.gmail.com）
# SMTP_HOST=smtp.163.com
# 端口：465=SSL（推荐 163/QQ），25/587=STARTTLS
# SMTP_PORT=465
# 发件邮箱
# SMTP_USER=your-sender@163.com
# 授权码（163 在网页设置 → POP3/SMTP/IMAP 里生成，不是登录密码）
# SMTP_PASS=your-auth-code
# 发件人显示名（可选）
# SMTP_FROM_NAME=NOFX Notifier

# 收件人，多个用英文逗号分隔
# NOTIFY_TO=your-receiver@qq.com

# 同一类型告警的最小发送间隔（秒），默认 60；防止异常爆雷邮件刷屏
# NOTIFY_MIN_INTERVAL=60
# 异步队列大小，默认 100
# NOTIFY_QUEUE_SIZE=100
# 单封 SMTP 邮件总发送上限（秒），默认 15；超时只影响通知 worker
# NOTIFY_SEND_TIMEOUT_SECONDS=15
# 启动时是否发一封测试邮件确认配置，默认 true
# NOTIFY_SEND_ON_STARTUP=true

# Binance 数据源事故通知：首次成功告警后 1 小时提醒一次，之后每 6 小时提醒
# COPYTRADE_SOURCE_INCIDENT_FIRST_REMINDER_SECONDS=3600
# COPYTRADE_SOURCE_INCIDENT_REMINDER_SECONDS=21600
# 单次 HTTP 429 的静默观察窗口（秒），默认 5 分钟；窗口内恢复则不发事故/恢复邮件
# COPYTRADE_SOURCE_INCIDENT_429_GRACE_SECONDS=300
